# Copy to a private environment file, fill locally, never commit actual secrets.
# Set false after applying SQL separately with a migration role.
MUSIC_MIGRATE=true
MUSIC_ADDR=127.0.0.1:37831
MUSIC_ORIGIN=https://music.example.com
MUSIC_APP_ID=betago-music
MUSIC_COOKIE_SECURE=true
MUSIC_DATABASE_URL=host=postgres.example.internal port=5432 user=music dbname=betago sslmode=verify-full
# Leave empty unless deliberately using an owned media proxy (exact hostname only).
MUSIC_OWNED_MEDIA_HOST=
MUSIC_NETEASE_URL=http://anonymous-catalogue.internal:3335
# Optional existing operator-owned authorization. Secret env only; no browser login,
# QR, refresh loop, URL query or application-user identity is derived from it.
MUSIC_NETEASE_COOKIE=
# Explicit owned MinIO cache. Internal endpoint and public origin are exact origins;
# public HTTPS host/port must be preserved by the GET/HEAD-only object proxy.
MUSIC_MINIO_CACHE_ENABLED=false
MUSIC_MINIO_ENDPOINT=http://minio.internal:9000
MUSIC_MINIO_PUBLIC_ORIGIN=https://music.example.com
MUSIC_MINIO_BUCKET=cloudmusic
MUSIC_MINIO_REGION=us-east-1
MUSIC_MINIO_ACCESS_KEY=
MUSIC_MINIO_SECRET_KEY=
# Default read-only. Enabling adds bounded complete-track write-through caching.
MUSIC_MINIO_CACHE_WRITE_ENABLED=false
# Optional. Set MUSIC_APP_ID to the actual app ID, and configure allowed redirect URL.
MUSIC_FEISHU_APP_SECRET=
MUSIC_FEISHU_REDIRECT_URI=https://music.example.com/play
# Standalone server can serve an existing production frontend build.
MUSIC_STATIC_DIR=/srv/betago-music/dist
